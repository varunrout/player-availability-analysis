# Deployment identity and secrets.
# Copy to .env for local development. .env is git-ignored and must never be committed.
# Authentication uses Application Default Credentials; no service-account keys.

GCP_PROJECT_ID=player-availability-analysis
GCP_REGION=europe-west2

GCS_DATA_BUCKET=paa-data-979927072833
GCS_ARTIFACTS_BUCKET=paa-artifacts-979927072833

BQ_CORE_DATASET=paa_core
BQ_ML_DATASET=paa_ml
BQ_PRODUCT_DATASET=paa_product

ARTIFACT_REGISTRY_REPOSITORY=paa-containers

# Configuration layering.
# PAA_ENV selects the YAML layer applied on top of configs/base.yaml.
# Valid values: local, dev, prod. Defaults to local when unset.
PAA_ENV=local

# PAA_CONFIG_DIR overrides the configuration directory. Leave unset to use
# <repo root>/configs. Set this in containers where the repo layout differs.
# PAA_CONFIG_DIR=/app/configs

# Any analytical value in configs/*.yaml can be overridden without a code change
# using the PAA_ANALYSIS_ prefix. Environment always beats YAML.
# PAA_ANALYSIS_INJURY_EPISODE_GAP_DAYS=7
