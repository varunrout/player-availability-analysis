# Copy to .env.local for local development. .env* is git-ignored except this file.
# Never commit real values.

# Internal API base URL. In Cloud Run this is the API service's internal URL;
# locally, point at the API running on localhost.
PAA_API_BASE_URL=http://localhost:8080

# Set to "true" only when deployed on Cloud Run: fetches a Google-signed identity
# token from the metadata server so the internal-ingress API can verify the
# request came from this service's own identity. Leave unset for local dev.
PAA_USE_METADATA_IDENTITY_TOKEN=

# Shared review credentials, checked by middleware.ts. Provisioned from Secret
# Manager at deploy time (DEC-064). Never commit real values.
PAA_WEB_USERNAME=
PAA_WEB_PASSWORD=
