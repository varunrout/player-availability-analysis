# Line-ending policy.
#
# All text is stored as LF in the repository and checked out as LF in the
# working tree. The project builds Linux containers for Cloud Run and Vertex,
# so LF everywhere keeps local files byte-identical to what runs in the cloud
# and prevents shell scripts and Docker builds breaking on CRLF.
#
# Without this, Windows-side tooling rewrites endings on write, which produced
# 27 files showing as fully modified with no content change and made real
# diffs unreadable during review.

* text=auto eol=lf

# Explicit text types
*.py      text eol=lf
*.pyi     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.sql     text eol=lf
*.sh      text eol=lf
*.ipynb   text eol=lf
Makefile  text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary types. Never transform these; corruption would be silent.
*.parquet binary
*.feather binary
*.zip     binary
*.gz      binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.svg     binary
*.pdf     binary
*.joblib  binary
*.pkl     binary
*.xlsx    binary
